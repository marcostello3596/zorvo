# ═══════════════════════════════════════════════════════════════════════════
# ZORVO — variables de entorno
#
# Copiá a .env.local y completá. lib/env.ts valida esto al arrancar: si falta
# algo, falla el build y no una request en horario pico.
#
# .env.local NUNCA va al repositorio.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys.
#
# Supabase renombró el esquema de claves: las nuevas son "publishable" y
# "secret", y reemplazan a "anon" y "service_role" sin cambios de código.
# Los nombres de las variables de acá quedan como estaban para no tocar la
# app; lo que cambia es de qué campo del dashboard se copian.
#
#   NEXT_PUBLIC_SUPABASE_URL       → https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  → Publishable key   (sb_publishable_...)
#   SUPABASE_SERVICE_ROLE_KEY      → Secret key        (sb_secret_...)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Solo servidor ──────────────────────────────────────────────────────────
# Ignora RLS: quien la tenga lee y escribe toda la base.
# Nunca en una variable NEXT_PUBLIC_*, nunca en el repositorio, nunca en un chat.

SUPABASE_SERVICE_ROLE_KEY=

# Master key para derivar los secretos HMAC de las credenciales (§6).
# Generá una con:  openssl rand -base64 48
# En producción va en Supabase Vault, no acá.
CREDENTIAL_HMAC_MASTER=

# ── Acceso de prueba — SOLO DESARROLLO ─────────────────────────────────────
# Habilita el botón "Entrar como socio de prueba" en /ingresar, que crea una
# sesión sin mandar mail ni pasar por Google.
#
# No hace falta sacarla al desplegar: la función tira excepción si NODE_ENV
# es "production", que es lo que ponen Vercel y `next build` por su cuenta.
# Igual, cuando tengas SMTP o Google andando, borrá app/(auth)/dev-actions.ts
# y components/primitives/BotonPrueba.tsx.

ZORVO_DEV_LOGIN=1

# ── V2 — todavía no se usan ────────────────────────────────────────────────
# GOOGLE_WALLET_SA_KEY=
# APPLE_PASS_CERT=
# APPLE_PASS_KEY=
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
