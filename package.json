{
  "name": "zorvo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > types/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked --schema public > types/database.types.ts",
    "db:diff": "supabase db diff -f",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.40.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3"
  }
}
